# Copy to .env.local for local development, and set the same two values in
# Netlify → Site configuration → Environment variables.
# Only PUBLIC values belong here. Never put the service-role key or email secrets
# in any VITE_ variable: they would be bundled into the website.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: the Amazon gift card claim code, revealed after she opens the gift.
# Set it ONLY in Netlify, never commit it. Anyone with the site link can read it,
# so leave it unset if Amazon is emailing the card to her directly.
VITE_GIFT_CARD_CODE=
